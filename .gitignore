# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# typescript incremental build cache (절대 깃에 들어가면 안 됨)
tsconfig.tsbuildinfo
*.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build-*.log

# local env files
.env*.local
.env
.playwright-mcp/

# 훅 상태(세션별 캡처 열람 기록) — 커밋하지 않는다
.claude/state/

# 루트에 쌓이던 작업 찌꺼기 (2026-08-23 대청소 — 로그 215개·캡처 104개가 커밋돼 있었다)
/*.log
/*.png
/*.bat
/.tmp/

# 파이프라인 호출 로그(지시문 전문) — 크고 매번 바뀐다
scripts/reports/logs/
# 파이프라인 중간 산출물 — 재생성된다 (설계도·검색 후보·초안·렌더 캡처). 보고서 .md 는 남긴다
scripts/output/plan-*.json
scripts/output/found-*.json
scripts/drafts/
scripts/reports/*.png
