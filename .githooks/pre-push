#!/bin/bash
# pre-push hook: ① 배선 무결성(고아 허브·매니페스트) ② 스포크 품질 미달 시 push 차단
# 2026-08-13: .git/hooks(버전관리 밖)에서 .githooks/로 이전 — core.hooksPath=.githooks.
#   scripts/hooks-pre-push.sh 가 8/1 구버전인 채 진본과 갈라져 있었다. 진본은 이 파일 하나다.
ROOT="$(git rev-parse --show-toplevel)"

# ── ⓪ CLAUDE.md 비대 차단 (2026-08-13 신설) ──
# 7/21 에 676→157줄로 청소했는데 12일 만에 238줄이 됐다. 상한이 없어서다.
# 훅·게이트가 이미 강제하는 규칙을 산문으로 또 적으면 여기서 막는다.
CMD_LINES=$(wc -l < "$ROOT/CLAUDE.md")
if [ "$CMD_LINES" -gt 80 ]; then
  echo "🚫 push 차단됨 — CLAUDE.md ${CMD_LINES}줄 (상한 80줄)"
  echo "   규칙은 검사기(scripts/check-*)나 자동 로드 규칙(.claude/rules/)에 넣고, CLAUDE.md에는 색인 한 줄만 남긴다"
  exit 1
fi

# ── ① 배선 무결성 게이트 (registry↔manifest 고아 검출) ──
echo "🔗 배선 무결성 검증 중 (고아 허브·매니페스트 정합)..."
npx tsx "$ROOT/scripts/verify-integrity.ts" --strict
INTEG=$?
if [ $INTEG -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 배선 오류(고아 허브 등). 허브 데이터파일+manifest 배선을 맞춘 뒤 재push"
  echo "   (무시하려면: git push --no-verify)"
  exit $INTEG
fi

# ── ①-B 타입 형태 게이트 (2026-08-09 신설) ──
# faq/faqData 를 섞어 써서 프리렌더가 죽은 사고. tsc 는 잡는데 아무도 안 돌렸다.
# next.config 의 ignoreBuildErrors 때문에 빌드도 못 잡는다. 가장 이른 자리에 둔다.
echo "🧩 타입 형태 검증 중 (faq/faqData 등 필드명)..."
npx tsx "$ROOT/scripts/check-type-shape.ts"
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 필드 이름을 타입에 맞춘다 (허브 faq / 스포크 faqData)"
  echo "   (무시하려면: git push --no-verify)"
  exit 1
fi

# ── ② 원문 대조 — 글 품질은 이거 하나다 (2026-08-16) ──
# 전에는 여기서 검사기 9개가 돌았다(스포크품질·타이틀소제목·팩트시트·타이틀출처·
# 문구버튼·신선도·중복·Q1~Q13). 사장님 지시로 하나로 합쳤다 —
# 3단계에서 뜬 추출본과 완성된 글을 맞춰보면 오차·누락·근거없는말·출처표기가 다 잡힌다.
echo "🔍 원문 대조 중 (추출본 ↔ 완성글)..."
npx tsx "$ROOT/scripts/check-source-match.ts"
SM=$?
if [ $SM -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 글의 숫자를 원문 추출본과 맞춘다"
  echo "   (무시하려면: git push --no-verify)"
  exit $SM
fi

exit 0
