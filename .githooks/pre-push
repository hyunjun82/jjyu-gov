#!/bin/bash
# pre-push hook: ① 배선 무결성(고아 허브·매니페스트) ② 스포크 품질 미달 시 push 차단
# 2026-08-13: .git/hooks(버전관리 밖)에서 .githooks/로 이전 — core.hooksPath=.githooks.
#   scripts/hooks-pre-push.sh 가 8/1 구버전인 채 진본과 갈라져 있었다. 진본은 이 파일 하나다.
ROOT="$(git rev-parse --show-toplevel)"

# ── ⓪ CLAUDE.md 비대 차단 (2026-08-13 신설) ──
# 7/21 에 676→157줄로 청소했는데 12일 만에 238줄이 됐다. 상한이 없어서다.
# 훅·게이트가 이미 강제하는 규칙을 산문으로 또 적으면 여기서 막는다.
CMD_LINES=$(wc -l < "$ROOT/CLAUDE.md")
if [ "$CMD_LINES" -gt 80 ]; then
  echo "🚫 push 차단됨 — CLAUDE.md ${CMD_LINES}줄 (상한 80줄)"
  echo "   규칙은 검사기(scripts/check-*)나 자동 로드 규칙(.claude/rules/)에 넣고, CLAUDE.md에는 색인 한 줄만 남긴다"
  exit 1
fi

# ── ⓪-A 셸 우회 관문 (2026-08-25 신설) ──
# 훅이 Write/Edit 만 봐서 셸로 파일을 만들면 문지기가 안 깨어났다.
# matcher 에 Bash 를 넣었는데, 이번엔 ls·grep 까지 막는 오탐이 났다.
# 막아야 할 것 4종 + 통과해야 할 것 11종을 같이 세워둔다. 하나라도 어긋나면 막는다.
echo "🚪 셸 우회 관문 검사 중 (셸로 새 글을 만들면 막히나)..."
node "$ROOT/scripts/hooks/selftest-bash-gate.mjs" | tail -2
BG=${PIPESTATUS[0]}
if [ $BG -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 셸 관문이 어긋났다 (막을 걸 놓쳤거나, 평소 명령을 막고 있다)"
  echo "   자세히: node scripts/hooks/selftest-bash-gate.mjs -v"
  exit $BG
fi

# ── ⓪-B 문지기 자가검사 (2026-08-25 신설) ──
# 저장을 막는 훅이 진짜 막는지 매번 채점한다.
# 이 시험지는 8/11 부터 있었는데 아무도 안 돌려서 14종이 2주째 뚫린 채였다.
# 한 번에 0으로 만들 수 없으니 기준선을 둔다 —
#   나빠지면 막고, 좋아지면 기준선이 저절로 내려가 다시는 못 올라간다.
echo "🚪 문지기 자가검사 중 (4단계를 건너뛰면 저장이 막히나)..."
SELF_OUT=$(node "$ROOT/scripts/hooks/selftest-title-log.mjs" 2>&1)
echo "$SELF_OUT" | grep -E "^★실패|종 중"
BASE_F="$ROOT/scripts/selftest-baseline.txt"
FAIL=$(printf '%s' "$SELF_OUT" | tr -d '
' | grep -o "실패 [0-9]*종" | tail -1 | grep -o "[0-9]*")
BASE=$(cat "$BASE_F" 2>/dev/null || echo 99)
if [ -z "$FAIL" ]; then
  echo "🚫 push 차단됨 — 자가검사가 결과를 못 냈다(시험지 자체가 깨졌다)"
  exit 1
fi
if [ "$FAIL" -gt "$BASE" ]; then
  echo ""
  echo "🚫 push 차단됨 — 뚫린 곳이 ${BASE}개에서 ${FAIL}개로 늘었다"
  echo "   위 ★실패 중 이번에 생긴 것을 고친다."
  exit 1
fi
if [ "$FAIL" -lt "$BASE" ]; then
  echo "$FAIL" > "$BASE_F"
  echo "   기준선 ${BASE} → ${FAIL} (내려갔다. 다시는 못 올라간다)"
fi
echo "   뚫린 곳 ${FAIL}개 / 기준선 ${BASE}개"

# ── ① 배선 무결성 게이트 (registry↔manifest 고아 검출) ──
echo "🔗 배선 무결성 검증 중 (고아 허브·매니페스트 정합)..."
npx tsx "$ROOT/scripts/verify-integrity.ts" --strict
INTEG=$?
if [ $INTEG -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 배선 오류(고아 허브 등). 허브 데이터파일+manifest 배선을 맞춘 뒤 재push"
  echo "   (무시하려면: git push --no-verify)"
  exit $INTEG
fi

# ── ①-A 검색 색인 신선도 (2026-08-26 신설) ──
# public/search-index.json 은 커밋된 정적 파일인데 아무도 다시 안 만들었다.
# 검색 신설일(2026-08-08) 이후 쓴 글 175편이 사이트 검색에서 통째로 빠져 있었다.
# 보험사 고객센터 27편도 전부 안 잡혔다. 글은 있는데 사이트 안에서 못 찾는다.
# 배포는 prebuild 를 안 태우므로 여기서 다시 만들고, 달라지면 커밋하라고 막는다.
echo "🔎 검색 색인 신선도 확인 중 (새 글이 사이트 검색에 잡히나)..."
BEFORE=$(node -e "try{const j=require('$ROOT/public/search-index.json');console.log((Array.isArray(j)?j:j.rows||[]).length)}catch(e){console.log(0)}")
npx tsx "$ROOT/scripts/build-search-index.ts" > /dev/null 2>&1
AFTER=$(node -e "try{const j=require('$ROOT/public/search-index.json');console.log((Array.isArray(j)?j:j.rows||[]).length)}catch(e){console.log(0)}")
if ! git -C "$ROOT" diff --quiet -- public/search-index.json; then
  echo ""
  echo "🚫 push 차단됨 — 검색 색인이 낡았다 ($BEFORE → $AFTER 건)"
  echo "   방금 다시 만들었다. 이것까지 담아서 다시 커밋하고 push 해라:"
  echo "     git add public/search-index.json && git commit --amend --no-edit"
  exit 1
fi
echo "   색인 ${AFTER}건 — 최신"

# ── ①-C 고객센터 전용 게이트 (2026-08-26 신설) ──
# 기존 게이트는 전부 핵심콕콕 템플릿 기준이라 고객센터 글을 제대로 심판하지 못한다
# (check-type-shape·check-button-variety·check-source-match 에 고객센터 예외처리가 0곳이다).
# 오늘 증권사 19곳에 보험 문구(사고접수·긴급출동)가 들어갔는데 게이트가 아니라 사람 눈이 잡았다.
# 45편이라 눈에 띄었을 뿐 수천 편이면 못 본다. 눈이 하던 일을 여기로 옮긴다.
echo "☎ 고객센터 검사 중 (업종 말·번호·원문이 서로 맞나)..."
npx tsx "$ROOT/scripts/check-callcenter.ts"
CC=$?
if [ $CC -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 고객센터 글이 데이터·원문과 어긋난다"
  echo "   (무시하려면: git push --no-verify)"
  exit $CC
fi

# ── ①-D 문장 검사 (2026-08-27 신설) ──
# 사장님 지적: "100개 작성 후 또 오차 있어서 진행하면 사용량 2~3배 시간도 2~3배야"
# 오늘 난 오차 셋 중 둘은 게이트가 있었고(원문 대조·업종 말) 하나는 없었다 —
# 생성기가 만든 문장 자체가 깨진 것. "한국케이블텔레콤 상담은  안에서만 됩니다"(빈칸 58편),
# "09:00~18:00(주말, 공휴일  안에서만"(괄호 안에서 잘림), "유튜브은"(조사).
# 다 쓰고 나서 사람 눈이 잡아 131편을 다시 찍는 데 40분이 들었다. 1편에서 걸렸으면 1분이다.
echo "✍ 문장 검사 중 (변수가 빈칸이 되거나 조사가 틀어졌나)..."
npx tsx "$ROOT/scripts/check-sentence.ts"
SN=$?
if [ $SN -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 생성기가 만든 문장이 깨졌다"
  echo "   조사는 scripts/lib/josa.ts 를 거치게 한다 (게이트도 같은 파일로 판정한다)"
  echo "   (무시하려면: git push --no-verify)"
  exit $SN
fi

# ── ①-E 빌드 결과 검사 (2026-09-01 신설) ──
# 사장님 지적("표 오차없고?")에서 나왔다. 표를 보다 딴 게 걸렸다 —
# 온라인 고객센터 12편이 통째로 깨져 있었다. youtube 주소에 11번가 정보가 나오고
# 쿠팡·넷플릭스 등 11편은 본문이 비어 있었다.
# 8/27 온라인 업종을 통신에서 뗄 때 registry.ts 에서 11번가만 옮겨졌기 때문이다.
# JSON 과 글 파일은 멀쩡해서 check-callcenter 가 212편 통과로 봤다 —
# "그 글이 어느 주소로 나가는가" 는 아무도 안 보고 있었다.
# 그래서 여기서는 out/ (사람이 실제로 받는 파일)을 본다.
# out/ 이 없으면 스스로 생략한다 — 빌드를 강제하지는 않는다.
echo "📄 빌드 결과 검사 중 (그 주소에 그 회사가 나오나)..."
npx tsx "$ROOT/scripts/check-built-page.ts"
BP=$?
if [ $BP -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 빌드 결과가 데이터와 어긋난다"
  echo "   \"남의 회사가 나온다\"·\"본문이 비어 있다\" 는 대개 data/spokes/registry.ts 가"
  echo "   그 글을 엉뚱한 허브 아래 걸어 둔 것이다 (JSON 의 industry 와 대조한다)"
  echo "   (무시하려면: git push --no-verify)"
  exit $BP
fi

# ── ①-B 타입 형태 게이트 (2026-08-09 신설) ──
# faq/faqData 를 섞어 써서 프리렌더가 죽은 사고. tsc 는 잡는데 아무도 안 돌렸다.
# next.config 의 ignoreBuildErrors 때문에 빌드도 못 잡는다. 가장 이른 자리에 둔다.
echo "🧩 타입 형태 검증 중 (faq/faqData 등 필드명)..."
npx tsx "$ROOT/scripts/check-type-shape.ts"
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 필드 이름을 타입에 맞춘다 (허브 faq / 스포크 faqData)"
  echo "   (무시하려면: git push --no-verify)"
  exit 1
fi

# ── ② 원문 대조 — 글 품질은 이거 하나다 (2026-08-16) ──
# 전에는 여기서 검사기 9개가 돌았다(스포크품질·타이틀소제목·팩트시트·타이틀출처·
# 문구버튼·신선도·중복·Q1~Q13). 사장님 지시로 하나로 합쳤다 —
# 3단계에서 뜬 추출본과 완성된 글을 맞춰보면 오차·누락·근거없는말·출처표기가 다 잡힌다.
echo "🔍 원문 대조 중 (추출본 ↔ 완성글)..."
npx tsx "$ROOT/scripts/check-source-match.ts"
SM=$?
if [ $SM -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 글의 숫자를 원문 추출본과 맞춘다"
  echo "   (무시하려면: git push --no-verify)"
  exit $SM
fi

# ── ③ 버튼 문구 도배 (2026-08-20 신설) ──
# 실손 62편에서 같은 틀을 세 번 연속 찍어냈고 세 번 다 사람이 라이브에서 발견했다.
#   1차 cue 124/129 가 "내 증권이 몇 세대인지" · 2차 상단버튼 62개가 전부 "~ 보기"
#   3차 고친다며 넣은 것이 61개 "내 ~", 24개 "…되는지 확인하기"
# 기존 게이트는 한 페이지 안의 중복만 봐서 배치 전체에 깔린 틀을 못 잡았다.
echo "🔍 버튼 문구 도배 검사 중..."
npx tsx "$ROOT/scripts/check-button-variety.ts"
BV=$?
if [ $BV -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 버튼·cue 를 서로 다른 결로 다시 쓴다"
  echo "   정본: docs/button-copy.md"
  echo "   (무시하려면: git push --no-verify)"
  exit $BV
fi

# ── ④ 승인 도장 (2026-08-20 신설) ──
# 4단계 중 2단계(구성표 승인)만 기계가 안 잡아서 같은 실수가 세 번 라이브까지 나갔다.
# 승인은 채팅에서 일어나 기계가 못 보니, 파일에 도장을 남기고 그걸 본다.
echo "🔍 구성표 승인 확인 중..."
npx tsx "$ROOT/scripts/check-stage-approval.ts"
AP=$?
if [ $AP -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 승인 없이 쓴 글이 있다"
  echo "   구성표를 채팅에 올려 승인받고 approved:true 로 도장을 찍는다"
  echo "   (무시하려면: git push --no-verify)"
  exit $AP
fi

# ── ⑤ 출처 링크 (2026-08-20 신설) ──
# 법제처 링크가 admRulSeq 만 붙어 있으면 별표 1(외화유동성관리)이 열린다.
# 추출본은 올바른 문서로 떴기 때문에 숫자 대조로는 절대 안 잡히던 구멍이다.
echo "🔍 출처 링크 확인 중 (링크를 실제로 연다)..."
npx tsx "$ROOT/scripts/check-source-links.ts"
SL=$?
if [ $SL -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 출처 링크가 엉뚱한 문서를 연다"
  echo "   (무시하려면: git push --no-verify)"
  exit $SL
fi

# ── ⑥ 수치 ↔ 출처 대조 (2026-08-23 신설) ──
# 링크가 200 인 것과 그 페이지에 이 숫자가 있는 것은 다른 말이다.
# 손보협회 FAQ 를 innerText 로 907자만 읽고 "근거 없다"고 오판한 날 만들었다.
# 이번 push 로 바뀐 콘텐츠 파일만 본다 — 옛 글 223건까지 한꺼번에 막으면 게이트가 꺼진다.
CHANGED=$(git diff --name-only --diff-filter=ACM origin/main...HEAD -- 'app/policy/*/content/**/*.tsx' 2>/dev/null)
if [ -n "$CHANGED" ]; then
  echo "🔍 수치 ↔ 출처 대조 중 (바뀐 글만)..."
  FILES=()
  while IFS= read -r f; do [ -n "$f" ] && FILES+=("$f"); done <<< "$CHANGED"
  npx tsx "$ROOT/scripts/check-source-backing.ts" "${FILES[@]}"
  SB=$?
  if [ $SB -ne 0 ]; then
    echo ""
    echo "🚫 push 차단됨 — 출처 저장본에 없는 수치가 있다"
    echo "   저장본이 비어서 못 읽은 것이면 먼저: npx tsx scripts/fetch-source.ts <URL>"
    echo "   (무시하려면: git push --no-verify)"
    exit $SB
  fi
fi

exit 0
