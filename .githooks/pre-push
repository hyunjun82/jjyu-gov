#!/bin/bash
# pre-push hook: ① 배선 무결성(고아 허브·매니페스트) ② 스포크 품질 미달 시 push 차단
# 2026-08-13: .git/hooks(버전관리 밖)에서 .githooks/로 이전 — core.hooksPath=.githooks.
#   scripts/hooks-pre-push.sh 가 8/1 구버전인 채 진본과 갈라져 있었다. 진본은 이 파일 하나다.
ROOT="$(git rev-parse --show-toplevel)"

# ── ⓪ CLAUDE.md 비대 차단 (2026-08-13 신설) ──
# 7/21 에 676→157줄로 청소했는데 12일 만에 238줄이 됐다. 상한이 없어서다.
# 훅·게이트가 이미 강제하는 규칙을 산문으로 또 적으면 여기서 막는다.
CMD_LINES=$(wc -l < "$ROOT/CLAUDE.md")
if [ "$CMD_LINES" -gt 80 ]; then
  echo "🚫 push 차단됨 — CLAUDE.md ${CMD_LINES}줄 (상한 80줄)"
  echo "   규칙은 검사기(scripts/check-*)나 자동 로드 규칙(.claude/rules/)에 넣고, CLAUDE.md에는 색인 한 줄만 남긴다"
  exit 1
fi

# ── ① 배선 무결성 게이트 (registry↔manifest 고아 검출) ──
echo "🔗 배선 무결성 검증 중 (고아 허브·매니페스트 정합)..."
npx tsx "$ROOT/scripts/verify-integrity.ts" --strict
INTEG=$?
if [ $INTEG -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 배선 오류(고아 허브 등). 허브 데이터파일+manifest 배선을 맞춘 뒤 재push"
  echo "   (무시하려면: git push --no-verify)"
  exit $INTEG
fi

# ── ①-B 타입 형태 게이트 (2026-08-09 신설) ──
# faq/faqData 를 섞어 써서 프리렌더가 죽은 사고. tsc 는 잡는데 아무도 안 돌렸다.
# next.config 의 ignoreBuildErrors 때문에 빌드도 못 잡는다. 가장 이른 자리에 둔다.
echo "🧩 타입 형태 검증 중 (faq/faqData 등 필드명)..."
npx tsx "$ROOT/scripts/check-type-shape.ts"
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 필드 이름을 타입에 맞춘다 (허브 faq / 스포크 faqData)"
  echo "   (무시하려면: git push --no-verify)"
  exit 1
fi

# ── ② 원문 대조 — 글 품질은 이거 하나다 (2026-08-16) ──
# 전에는 여기서 검사기 9개가 돌았다(스포크품질·타이틀소제목·팩트시트·타이틀출처·
# 문구버튼·신선도·중복·Q1~Q13). 사장님 지시로 하나로 합쳤다 —
# 3단계에서 뜬 추출본과 완성된 글을 맞춰보면 오차·누락·근거없는말·출처표기가 다 잡힌다.
echo "🔍 원문 대조 중 (추출본 ↔ 완성글)..."
npx tsx "$ROOT/scripts/check-source-match.ts"
SM=$?
if [ $SM -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 글의 숫자를 원문 추출본과 맞춘다"
  echo "   (무시하려면: git push --no-verify)"
  exit $SM
fi

# ── ③ 버튼 문구 도배 (2026-08-20 신설) ──
# 실손 62편에서 같은 틀을 세 번 연속 찍어냈고 세 번 다 사람이 라이브에서 발견했다.
#   1차 cue 124/129 가 "내 증권이 몇 세대인지" · 2차 상단버튼 62개가 전부 "~ 보기"
#   3차 고친다며 넣은 것이 61개 "내 ~", 24개 "…되는지 확인하기"
# 기존 게이트는 한 페이지 안의 중복만 봐서 배치 전체에 깔린 틀을 못 잡았다.
echo "🔍 버튼 문구 도배 검사 중..."
npx tsx "$ROOT/scripts/check-button-variety.ts"
BV=$?
if [ $BV -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 버튼·cue 를 서로 다른 결로 다시 쓴다"
  echo "   정본: docs/button-copy.md"
  echo "   (무시하려면: git push --no-verify)"
  exit $BV
fi

# ── ④ 승인 도장 (2026-08-20 신설) ──
# 4단계 중 2단계(구성표 승인)만 기계가 안 잡아서 같은 실수가 세 번 라이브까지 나갔다.
# 승인은 채팅에서 일어나 기계가 못 보니, 파일에 도장을 남기고 그걸 본다.
echo "🔍 구성표 승인 확인 중..."
npx tsx "$ROOT/scripts/check-stage-approval.ts"
AP=$?
if [ $AP -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 승인 없이 쓴 글이 있다"
  echo "   구성표를 채팅에 올려 승인받고 approved:true 로 도장을 찍는다"
  echo "   (무시하려면: git push --no-verify)"
  exit $AP
fi

# ── ⑤ 출처 링크 (2026-08-20 신설) ──
# 법제처 링크가 admRulSeq 만 붙어 있으면 별표 1(외화유동성관리)이 열린다.
# 추출본은 올바른 문서로 떴기 때문에 숫자 대조로는 절대 안 잡히던 구멍이다.
echo "🔍 출처 링크 확인 중 (링크를 실제로 연다)..."
npx tsx "$ROOT/scripts/check-source-links.ts"
SL=$?
if [ $SL -ne 0 ]; then
  echo ""
  echo "🚫 push 차단됨 — 출처 링크가 엉뚱한 문서를 연다"
  echo "   (무시하려면: git push --no-verify)"
  exit $SL
fi

# ── ⑥ 수치 ↔ 출처 대조 (2026-08-23 신설) ──
# 링크가 200 인 것과 그 페이지에 이 숫자가 있는 것은 다른 말이다.
# 손보협회 FAQ 를 innerText 로 907자만 읽고 "근거 없다"고 오판한 날 만들었다.
# 이번 push 로 바뀐 콘텐츠 파일만 본다 — 옛 글 223건까지 한꺼번에 막으면 게이트가 꺼진다.
CHANGED=$(git diff --name-only --diff-filter=ACM origin/main...HEAD -- 'app/policy/*/content/**/*.tsx' 2>/dev/null)
if [ -n "$CHANGED" ]; then
  echo "🔍 수치 ↔ 출처 대조 중 (바뀐 글만)..."
  FILES=()
  while IFS= read -r f; do [ -n "$f" ] && FILES+=("$f"); done <<< "$CHANGED"
  npx tsx "$ROOT/scripts/check-source-backing.ts" "${FILES[@]}"
  SB=$?
  if [ $SB -ne 0 ]; then
    echo ""
    echo "🚫 push 차단됨 — 출처 저장본에 없는 수치가 있다"
    echo "   저장본이 비어서 못 읽은 것이면 먼저: npx tsx scripts/fetch-source.ts <URL>"
    echo "   (무시하려면: git push --no-verify)"
    exit $SB
  fi
fi

exit 0
